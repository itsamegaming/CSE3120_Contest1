 00000000			.code
 00000000			main proc
				    ;seed rng 
 00000000  E8 00000000 E	    call Randomize
				    
 00000005			    newGame:
 00000005  E8 00000609		    call resetGame
 0000000A  E8 00000000 E	    call Clrscr
				    ;shows how many chips the player has
 0000000F  B2 1E		    mov dl, 30
 00000011  B6 0C		    mov dh, 12 
 00000013  E8 00000000 E	    call Gotoxy
 00000018  BA 000019F9 R	    mov EDX, OFFSET playerChipMessagePre
 0000001D  E8 00000000 E	    call WriteString
 00000022  A1 000019F5 R	    mov EAX, playerChips
 00000027  E8 00000000 E	    call WriteDec
 0000002C  BA 00001A03 R	    mov EDX, OFFSET playerChipMessageSuf
 00000031  E8 00000000 E	    call WriteString

				    ;asks player how much they want to bet
 00000036  B2 1E		    mov dl, 30
 00000038  B6 0E		    mov dh, 14
 0000003A  E8 00000000 E	    call Gotoxy
 0000003F  BA 00001A0A R	    mov EDX, OFFSET playerBetMessage
 00000044  E8 00000000 E	    call WriteString

 00000049  E8 00000000 E	    call ReadInt
				    
 0000004E  70 B5		    jo newGame            ; Reject invalid input

 00000050  83 F8 00		    cmp eax, 0
 00000053  7E B0		    jle newGame                ; Reject zero or negative bets

 00000055  3B 05 000019F5 R	    cmp eax, playerChips
 0000005B  77 A8		    ja newGame
 0000005D  A3 00001A2C R	    mov playerBet, eax                ; Reject bets above available chips

				           

 00000062  E8 00000000 E	    call Clrscr
				   ;Prints dealers first card and message
 00000067  BA 00001971 R	    mov EDX, OFFSET dealerMessage
 0000006C  E8 00000000 E	    call WriteString
 00000071  B2 19		    mov dl, 25
 00000073  B6 00		    mov dh, 0
 00000075  E8 00000000 E	    call Gotoxy
 0000007A  BA 00001A86 R	    mov EDX, OFFSET cardValueMessage
 0000007F  E8 00000000 E	    call WriteString
 00000084  E8 0000052C		    call DrawCard
				    ;adds card to score
 00000089  8B 34 85		    mov esi, cardTable[EAX*4]
	   00001839 R
 00000090  8A 98 00001909 R	    mov bl, cardValues[EAX] 
 00000096  00 1D 00001993 R	    add dealerScore, bl
				    ;counts how many aces dealer has for later
				    .IF bl == 11
 0000009C  80 FB 0B	   *	    cmp    bl, 00Bh
 0000009F  75 06	   *	    jne    @C0001
 000000A1  FE 05 00001995 R	        inc dealerAce
				    .endif
 000000A7		   *@C0001:
				    ;multiplies dealer card count by 12 to print card properly
 000000A7  0F B6 05		    movzx eax, dealerCardCount  
	   000019F4 R
 000000AE  6B C0 0C		    imul eax, eax, 12          
 000000B1  8A D0		    mov dl, al
 000000B3  B6 01		    mov dh, 1
 000000B5  E8 000004C8		    call PrintCardAt
 000000BA  FE 05 000019F4 R	    inc dealerCardCount
				    ;prints dealer score on screen
 000000C0  B2 24		    mov dl, 36
 000000C2  B6 00		    mov dh, 0
 000000C4  E8 00000000 E	    call Gotoxy
 000000C9  0F B6 05		    movzx EAX, dealerScore
	   00001993 R
 000000D0  E8 00000000 E	    call WriteDec
				    
				    


 000000D5  A3 0000198F R	    mov dealerHiddenCard, eax
 000000DA  BE 000017C4 R	    mov esi, OFFSET hiddenCard
 000000DF  8A 98 00001909 R	    mov bl, cardValues[EAX]
 000000E5  00 1D 00001993 R	    add dealerScore, bl
				   .IF bl == 11
 000000EB  80 FB 0B	   *	    cmp    bl, 00Bh
 000000EE  75 06	   *	    jne    @C0003
 000000F0  FE 05 00001995 R	        inc dealerAce
				    .endif
 000000F6		   *@C0003:
 000000F6  0F B6 05		    movzx eax, dealerCardCount  
	   000019F4 R
 000000FD  6B C0 0C		    imul eax, eax, 12          
 00000100  8A D0		    mov dl, al
 00000102  B6 01		    mov dh, 1
 00000104  E8 00000479		    call PrintCardAt
 00000109  FE 05 000019F4 R	    inc dealerCardCount

				    
				    .IF dealerScore > 21
 0000010F  80 3D 00001993 R
	   15		   *	    cmp    dealerScore, 015h
 00000116  76 0D	   *	    jbe    @C0005
 00000118  FE 0D 00001995 R	        dec dealerAce
 0000011E  80 2D 00001993 R	        sub dealerScore, 10
	   0A
				    .endIF
 00000125		   *@C0005:


 00000125  B2 00		    mov dl, 0
 00000127  B6 0E		    mov dh, 14
 00000129  E8 00000000 E	    call Gotoxy
 0000012E  BA 00001980 R	    mov EDX, OFFSET playerMessage
				    
 00000133  E8 00000000 E	    call WriteString
 00000138  B2 1F		    mov dl, 31
 0000013A  B6 0E		    mov dh, 14
 0000013C  E8 00000000 E	    call Gotoxy
 00000141  BA 00001A86 R	    mov EDX, OFFSET cardValueMessage
 00000146  E8 00000000 E	    call WriteString

 0000014B  E8 00000465		    call DrawCard
 00000150  8B 34 85		    mov esi, cardTable[eax*4]
	   00001839 R
 00000157  8A 98 00001909 R	    mov bl, cardValues[EAX]
 0000015D  00 1D 00001994 R	    add playerScore, bl
				    .IF bl == 11
 00000163  80 FB 0B	   *	    cmp    bl, 00Bh
 00000166  75 06	   *	    jne    @C0007
 00000168  FE 05 00001996 R	        inc playerAce
				    .endif
 0000016E		   *@C0007:
 0000016E  0F B6 05		    movzx eax, playerCardCount  
	   000019F3 R
 00000175  6B C0 0C		    imul eax, eax, 12          
 00000178  8A D0		    mov dl, al
 0000017A  B6 0F		    mov dh, 15
 0000017C  E8 00000401		    call PrintCardAt
 00000181  FE 05 000019F3 R	    inc playerCardCount

 00000187  E8 00000429		    call DrawCard
 0000018C  8B 34 85		    mov esi, cardTable[eax*4]
	   00001839 R
 00000193  8A 98 00001909 R	    mov bl, cardValues[EAX]
 00000199  00 1D 00001994 R	    add playerScore, bl
				    .IF bl == 11
 0000019F  80 FB 0B	   *	    cmp    bl, 00Bh
 000001A2  75 06	   *	    jne    @C0009
 000001A4  FE 05 00001996 R	        inc playerAce
				    .endif
 000001AA		   *@C0009:
 000001AA  0F B6 05		    movzx eax, playerCardCount  
	   000019F3 R
 000001B1  6B C0 0C		    imul eax, eax, 12          
 000001B4  8A D0		    mov dl, al
